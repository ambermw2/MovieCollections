{{> menu id="about"}}

<div class="dashboard about-page">
  <h1>{{title}}</h1>

  <div class="about-content">
    <div class="contact-details">
      <h3>Contact Information</h3>
      <p><strong>Author:</strong> {{aboutInfo.author}}</p>
      <p><strong>Company:</strong> {{aboutInfo.company}}</p>
      <p><strong>Email:</strong> {{aboutInfo.email}}</p>
      <p><strong>Phone:</strong> {{aboutInfo.phone}}</p>
    </div>

    <div class="location-map">
      <h3>Location</h3>
      <img src="{{aboutInfo.location}}" alt="Map" class="map-image">
    </div>

  </div>

  
</div>