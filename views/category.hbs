{{> menu id="dashboard"}}

<div class="ui container category-page">
  <h1 class="ui centered header category-title">{{title}}</h1>

  <div class="ui center aligned segment">
    <img src="{{image}}" alt="{{title}}" class="category-page-image">
  </div>

  <div class="ui segment">
    <h2 class="ui centered header category-title">{{title}}</h2>
    {{> listmovies movies=movies categoryTitle=title }}
  </div>

  <div class="ui segment">
    {{> addmovie category=category}}
  </div>

  <a href="/dashboard" class="back-link">
    <i class="arrow left icon"></i> Back to Dashboard
  </a>
</div>