<form class="ui form segment" action="/category/{{category.title}}/addmovie" method="POST">
  <div class="three fields">
    <div class="field">
      <label>Movie Title</label>
      <input type="text" name="title" placeholder="Movie Title" required>
    </div>

    <div class="field">
      <label>Director</label>
      <input type="text" name="director" placeholder="Director" required>
    </div>

    <div class="field">
      <label>Rating</label>
      <input type="number" name="rating" min="1" max="5" placeholder="1-5" required>
    </div>
  </div>

  <button class="ui blue button" type="submit">Add Movie</button>
</form>