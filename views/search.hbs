{{> menu id="dashboard"}}

<section class="ui container">
  <h2 class="ui header">Movie Search</h2>

  <form action="/searchMovies" method="GET" class="ui form">
    <div class="ui inline fields">
      <div class="field">
        <input type="text" name="searchTerm" placeholder="Search movies..." value="{{search}}">
      </div>

      <div class="field">
        <label>Sort by:</label>
        <select class="ui dropdown" name="sort">
          <option value="title" {{#if titleSelected}}selected{{/if}}>Title</option>
          <option value="rating" {{#if ratingSelected}}selected{{/if}}>Rating</option>
        </select>
      </div>

      <div class="field">
        <label>Order:</label>
        <select class="ui dropdown" name="order">
          <option value="asc" {{#if ascSelected}}selected{{/if}}>↑</option>
          <option value="desc" {{#if descSelected}}selected{{/if}}>↓</option>
        </select>
      </div>

      <div class="field">
        <button class="ui blue button" type="submit">Search</button>
      </div>
    </div>
  </form>

  {{#if movies}}
    <table class="ui unstackable striped table">
      <thead>
        <tr>
          <th>Movie</th>
          <th>Director</th>
          <th>Rating</th>
        </tr>
      </thead>
      <tbody>
        {{#each movies}}
          <tr>
            <td>
              {{#if this.title}}
                {{this.title}}
              {{else}}
                {{this}}
              {{/if}}
            </td>
            <td>
              {{#if this.director}}
                {{this.director}}
              {{else}}
                -
              {{/if}}
            </td>
            <td>
              {{#if this.rating}}
                {{this.rating}} / 5
              {{else}}
                -
              {{/if}}
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <h3 class="ui message">No movies found.</h3>
  {{/if}}
</section>